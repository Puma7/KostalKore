{
  "options": {
    "step": {
      "init": {
        "title": "Modbus & MQTT Bridge Settings",
        "description": "Enable direct Modbus TCP access to the inverter. This allows battery charge/discharge control and shares data via MQTT with external systems (evcc, iobroker). Security note: The Modbus proxy should stay on 127.0.0.1 unless you explicitly need remote access.\n\nDetected access role: {access_role}\nWrite access: {write_access}",
        "data": {
          "modbus_enabled": "Enable Modbus TCP",
          "modbus_port": "Modbus TCP Port",
          "modbus_unit_id": "Modbus Unit ID",
          "modbus_endianness": "Byte Order (Endianness)",
          "mqtt_bridge_enabled": "Enable MQTT Bridge",
          "modbus_proxy_enabled": "Enable Modbus Proxy Server",
          "modbus_proxy_port": "Modbus Proxy Port",
          "modbus_proxy_bind": "Modbus Proxy Bind Address (default: 127.0.0.1)",
          "ksem_enabled": "Enable external KSEM source",
          "ksem_host": "KSEM Host/IP (empty = inverter host)",
          "ksem_port": "KSEM Modbus TCP Port",
          "ksem_unit_id": "KSEM Modbus Unit ID",
          "modbus_proxy_client_timeout_s": "Expected proxy traffic timeout (seconds, 0 = disabled)"
        }
      },
      "modbus_test": {
        "title": "Modbus Connection Test",
        "description": "Connection test result:\n\n{test_result}\n"
      }
    },
    "error": {
      "modbus_test_failed": "Modbus connection test failed – check settings and network",
      "invalid_bind_address": "Proxy bind address must be a literal IP address (e.g. 127.0.0.1 for local-only or 0.0.0.0 for all interfaces)"
    },
    "abort": {
      "unsupported_ha_version": "This integration requires Home Assistant 2024.12.0 or newer (the installed version does not provide the options-flow config_entry property)"
    }
  },
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
