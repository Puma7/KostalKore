      "reauth_confirm": {
        "description": "Re-enter your credentials. The host from the existing configuration will be used.",
        "data": {
          "host": "Host/IP (read-only, uses existing entry)",
          "password": "[%key:common::config_flow::data::password%]",
          "service_code": "[%key:component::kostal_kore::config::step::user::data::service_code%]"
        }
      },
      "reconfigure": {
        "description": "Use a manual host/IP or leave host empty to auto-discover in local networks.",
        "data": {
          "host": "Host/IP (optional for auto-discovery)",
          "password": "[%key:common::config_flow::data::password%]",
          "service_code": "[%key:component::kostal_kore::config::step::user::data::service_code%]"
        }
