        "title": "First-time Setup Wizard",
        "description": "Host: {detected_host}\nDetected access role: {access_role}\nWrite access: {write_access}\n\nSelect which optional features should be enabled immediately.",
        "data": {
          "modbus_enabled": "Enable Modbus TCP",
          "modbus_port": "Modbus TCP Port",
          "modbus_unit_id": "Modbus Unit ID",
          "modbus_endianness": "Byte Order (Endianness)",
